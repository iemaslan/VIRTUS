# Get a key at https://console.anthropic.com — without it the app still runs,
# with explanations composed in code instead of written by the model.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Only needed for an identity-linked API key, which must name the workspace it
# acts in. A workspace key does not need this.
ANTHROPIC_WORKSPACE_ID=

# Get a key at https://console.anthropic.com — the app runs in a scripted demo
# mode if this is left unset, so it never dies on stage.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Alternative: run Claude on Google Cloud Vertex AI instead -----------------
# Useful if you are spending Google Cloud credits rather than Anthropic credits.
# Set the project ID and the app switches automatically — no other code changes.
# Auth comes from `gcloud auth application-default login`, not an API key, and
# you also need: npm install @anthropic-ai/vertex-sdk
#
# ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
# ANTHROPIC_VERTEX_REGION=global
